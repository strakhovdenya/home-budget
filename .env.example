# Copy into .env.local once implementation exists; NEVER commit actual values
DATABASE_URL=
# Local migration/test commands require ALL THREE URLs explicitly overridden
# to PostgreSQL on 127.0.0.1 with an explicit port and database. Neon is rejected.
# Direct URL for explicit migrations to an isolated local Docker DB.
DATABASE_URL_UNPOOLED=
HB_DATABASE_TARGET=
# Dedicated EMPTY test database only. Never set to production.
TEST_DATABASE_URL=
HB_TEST_DATABASE_TARGET=
# Google OAuth: docs/AUTH.md. Use a random secret of at least 32 characters.
# All four variables are required; missing/invalid configuration denies access.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_GOOGLE_EMAIL=
# Future: private document storage; do not enable public blob access for bank files
BLOB_READ_WRITE_TOKEN=
